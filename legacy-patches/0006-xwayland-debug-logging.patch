+static FILE *
+wcf_debug_file(void)
+{
+    static FILE *f = (FILE *) -1;
+    if (f == (FILE *) -1) {
+        const char *env = getenv("WCF_DEBUG");
+        if (env && *env && strchr(env, '/'))
+            f = fopen(env, "a");
+        else
+            f = NULL;
+    }
+    return f;
+}
+
+static void _X_ATTRIBUTE_PRINTF(1, 2)
+wcf_log(const char *fmt, ...)
+{
+    static int enabled = -1;
+    va_list ap;
+    char buf[512];
+    FILE *f;
+
+    if (enabled < 0) {
+        const char *env = getenv("WCF_DEBUG");
+        enabled = env && *env;
+    }
+    if (!enabled)
+        return;
+
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof buf, fmt, ap);
+    va_end(ap);
+    ErrorF("WCF t_us=%lld %s", (long long) GetTimeInMicros(), buf);
+    if ((f = wcf_debug_file())) {
+        fprintf(f, "WCF t_us=%lld %s", (long long) GetTimeInMicros(), buf);
+        fflush(f);
+    }
+}
